# ============================================================
# NEXUS-OMEGA (APEX-1) - Environment Configuration Template
# Copy to .env and populate with your credentials.
# ============================================================

# --- LLM Provider Keys ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
GOOGLE_API_KEY=your_google_ai_studio_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Default Routing ---
DEFAULT_MODEL=google/gemini-2.0-flash-001
FALLBACK_MODEL=deepseek/deepseek-chat

# --- Telegram Interface ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_AUTHORIZED_USER_ID=your_telegram_user_id_here

# --- Database ---
DATABASE_URL=postgresql://postgres:apexpassword@localhost:5432/nexus_omega

# --- Redis Broker ---
REDIS_URL=redis://localhost:6379/0

# --- LiveKit (WebRTC Voice/Vision) ---
LIVEKIT_URL=wss://your-livekit-server.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Web Dashboard ---
WEB_HOST=0.0.0.0
WEB_PORT=8000

# --- System Behavior ---
LOG_LEVEL=INFO
MAX_CONCURRENT_WORKERS=5
TASK_POLL_INTERVAL_SECONDS=2
